{
  "name": "handelsregister",
  "version": "0.4.0",
  "description": "Node.js SDK for accessing German company registry (Handelsregister) data via handelsregister.ai API",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "handelsregister": "cli/index.js"
  },
  "scripts": {
    "build": "npm run clean && npm run build:ts && npm run build:cli",
    "build:ts": "tsc && tsc --module esnext --outDir dist/esm",
    "build:cli": "tsc cli/index.ts --rootDir cli --outDir cli --module commonjs --target ES2018 --moduleResolution node --esModuleInterop --skipLibCheck --declaration",
    "clean": "rimraf dist cli/*.js cli/*.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"cli/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"cli/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "npm run lint && npm test",
    "prepare": "npm run build"
  },
  "keywords": [
    "handelsregister",
    "german-companies",
    "company-registry",
    "api-client",
    "business-data",
    "germany",
    "sdk",
    "typescript"
  ],
  "author": "handelsregister.ai",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "axios": "^1.18.1",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.3",
    "commander": "^11.0.0",
    "csv-parse": "^5.5.0",
    "csv-stringify": "^6.4.0",
    "dotenv": "^16.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cli-progress": "^3.11.0",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "nock": "^14.0.16",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist",
    "cli/*.js",
    "cli/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Handelsregister-AI/handelsregister-js.git"
  },
  "bugs": {
    "url": "https://github.com/Handelsregister-AI/handelsregister-js/issues"
  },
  "homepage": "https://handelsregister.ai"
}
